# Normalize text files and keep cross-platform line endings stable.

* text=auto

# .NET source and configuration
*.cs            text eol=lf
*.csproj        text eol=lf
*.props         text eol=lf
*.targets       text eol=lf
*.sln           text eol=lf
*.json          text eol=lf
*.code-workspace text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.md            text eol=lf
*.editorconfig  text eol=lf
*.gitignore     text eol=lf
*.gitattributes text eol=lf
.gitkeep        text eol=lf

# Scripts
*.sh            text eol=lf
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# Binary assets and packages
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.nupkg         binary
*.snupkg        binary
