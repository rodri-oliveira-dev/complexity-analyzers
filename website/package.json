{
  "name": "complexity-analyzers-documentation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "predev": "npm run sync:docs",
    "dev": "astro dev",
    "prebuild": "npm run sync:docs",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "npm run sync:docs",
    "check": "astro check",
    "pretest": "npm run sync:docs",
    "test": "vitest run",
    "test:routes": "node scripts/check-routes.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test:seo": "node scripts/validate-seo.mjs",
    "test:html": "html-validate \"dist/**/*.html\"",
    "test:spelling": "cspell --no-progress \"src/**/*.{astro,md,mdx,ts,json}\" \"scripts/**/*.mjs\" \"../docs/**/*.md\"",
    "lighthouse:collect": "node scripts/collect-lighthouse.mjs",
    "lighthouse:assert": "node scripts/summarize-lighthouse.mjs",
    "validate": "npm run check && npm run test && npm run build && npm run test:routes && npm run test:links && npm run test:seo && npm run test:html"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cspell/dict-pt-br": "2.4.4",
    "cspell": "10.4.0",
    "html-validate": "11.17.0",
    "lighthouse": "13.6.0",
    "pa11y-ci": "5.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": { "postcss-selector-parser": "7.1.6" }
}
